; JARVIS S1.T03 review viewer (Godot 4.7). Loads assets/JARVIS.glb (copy of blender/JARVIS.glb) at runtime.
config_version=5

[application]
config/name="JARVIS Review Viewer"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800

[rendering]
anti_aliasing/quality/msaa_3d=2
